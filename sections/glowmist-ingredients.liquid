{% comment %}
  GlowMist — Ingredients Section
  ===============================
  Displays key product ingredients with icons and descriptions.
  Each ingredient is a block editable from the Customizer.
{% endcomment %}

<section class="gm-section gm-ingredients" id="gm-ingredients" aria-label="Key ingredients">
  <div class="gm-container">

    <p class="gm-eyebrow">{{ section.settings.eyebrow | default: 'What\'s Inside' }}</p>
    <h2 class="gm-section__heading">{{ section.settings.heading | default: 'Clean, Powerful Ingredients' }}</h2>
    <p class="gm-section__subheading">{{ section.settings.subheading | default: 'Every drop is packed with nature\'s best — no parabens, no sulfates, no harmful chemicals.' }}</p>

    <div class="gm-ingredients__grid">

      {%- for block in section.blocks -%}
        <div class="gm-ingredient-card gm-animate-in" {{ block.shopify_attributes }}>

          {%- if block.settings.image != blank -%}
            <!-- Add image: ingredient illustration for {{ block.settings.name }} -->
            <img
              class="gm-ingredient-card__image"
              src="{{ block.settings.image | image_url: width: 160 }}"
              alt="{{ block.settings.name | escape }}"
              width="80"
              height="80"
              loading="lazy"
              decoding="async"
            >
          {%- else -%}
            <div class="gm-ingredient-card__icon">
              {%- case block.settings.icon -%}
                {%- when 'aloe' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                       stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M17 8C8 10 5.9 16.17 3.82 21.34l1.89.66.95-2.3c.48.17.98.3 1.34.3C19 20 22 3 22 3c-1 2-8 2.25-13 3.25S2 11.5 2 13.5s1.75 3.75 1.75 3.75"/>
                  </svg>
                {%- when 'orange' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                       stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M12 2v20"/>
                    <path d="M2 12h20"/>
                    <path d="m19.07 4.93-14.14 14.14"/>
                    <path d="m4.93 4.93 14.14 14.14"/>
                    <circle cx="12" cy="12" r="7"/>
                  </svg>
                {%- when 'rose' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                       stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 7.5a4.5 4.5 0 1 1 4.5 4.5M12 7.5A4.5 4.5 0 1 0 7.5 12M12 7.5V9m-4.5 3a4.5 4.5 0 1 0 4.5 4.5M7.5 12H9m7.5 0a4.5 4.5 0 1 1-4.5 4.5m4.5-4.5H15m-3 4.5V15"/>
                  </svg>
                {%- when 'acid' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                       stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>
                  </svg>
                {%- when 'tea' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                       stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M17 8h1a4 4 0 1 1 0 8h-1"/>
                    <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/>
                    <line x1="6" y1="2" x2="6" y2="4"/>
                    <line x1="10" y1="2" x2="10" y2="4"/>
                    <line x1="14" y1="2" x2="14" y2="4"/>
                  </svg>
                {%- else -%}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                       stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M12 16v-4"/>
                    <path d="M12 8h.01"/>
                  </svg>
              {%- endcase -%}
            </div>
          {%- endif -%}

          <h3 class="gm-ingredient-card__name">{{ block.settings.name }}</h3>
          <p class="gm-ingredient-card__desc">{{ block.settings.description }}</p>
        </div>
      {%- endfor -%}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "GlowMist Ingredients",
  "tag": "div",
  "class": "glowmist-ingredients-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "What's Inside"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Clean, Powerful Ingredients"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Section Subheading",
      "default": "Every drop is packed with nature's best — no parabens, no sulfates, no harmful chemicals."
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Ingredient Name",
          "default": "Aloe Vera"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Soothes and hydrates skin"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon (used if no image set)",
          "options": [
            { "value": "aloe", "label": "Leaf (Aloe Vera)" },
            { "value": "orange", "label": "Orange / Citrus" },
            { "value": "rose", "label": "Flower (Rose Water)" },
            { "value": "acid", "label": "Droplet (Hyaluronic Acid)" },
            { "value": "tea", "label": "Cup (Green Tea)" },
            { "value": "default", "label": "Info (Default)" }
          ],
          "default": "aloe"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Ingredient Image (optional)",
          "info": "Add an ingredient illustration. 160×160px recommended."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GlowMist Ingredients",
      "blocks": [
        { "type": "ingredient", "settings": { "name": "Aloe Vera", "description": "Soothes and deeply hydrates irritated or dry skin, leaving it feeling calm and refreshed.", "icon": "aloe" } },
        { "type": "ingredient", "settings": { "name": "Rose Water", "description": "Refreshes and tones your skin while providing a natural, subtle fragrance.", "icon": "rose" } },
        { "type": "ingredient", "settings": { "name": "Hyaluronic Acid", "description": "Helps retain moisture by holding up to 1000x its weight in water for plump, dewy skin.", "icon": "acid" } },
        { "type": "ingredient", "settings": { "name": "Green Tea Extract", "description": "Rich in antioxidants, it supports your skin's natural barrier against environmental stress.", "icon": "tea" } }
      ]
    }
  ]
}
{% endschema %}
