{% comment %}
  GlowMist — Benefits Section
  ============================
  Responsive grid of product benefit cards.
  Each benefit is a block with an icon, title, and description,
  editable from the Shopify Theme Customizer.
{% endcomment %}

<section class="gm-section gm-benefits" id="gm-benefits" aria-label="Product benefits">
  <div class="gm-container">

    <p class="gm-eyebrow">{{ section.settings.eyebrow | default: 'Why GlowMist?' }}</p>
    <h2 class="gm-section__heading">{{ section.settings.heading | default: 'Why You\'ll Love GlowMist' }}</h2>
    <p class="gm-section__subheading">{{ section.settings.subheading | default: 'Crafted with clean ingredients for skin that feels refreshed, hydrated, and glowing — every single day.' }}</p>

    <div class="gm-benefits__grid">

      {%- for block in section.blocks -%}
        <div class="gm-benefit-card gm-animate-in" {{ block.shopify_attributes }}>

          <div class="gm-benefit-card__icon">
            {%- case block.settings.icon -%}
              {%- when 'hydration' -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>
                </svg>
              {%- when 'refresh' -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21.5 2v6h-6"/>
                  <path d="M2.5 22v-6h6"/>
                  <path d="M2.5 16s2.5-7.5 9.5-7.5 9.5 7.5 9.5 7.5"/>
                  <path d="M21.5 8s-2.5 7.5-9.5 7.5S2.5 8 2.5 8"/>
                </svg>
              {%- when 'formula' -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M10 2v7.527a2 2 0 0 1-.211.896L4.72 20.55a1 1 0 0 0 .9 1.45h12.76a1 1 0 0 0 .9-1.45l-5.069-10.127A2 2 0 0 1 14 9.527V2"/>
                  <path d="M8.5 2h7"/>
                </svg>
              {%- when 'travel' -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M17.8 19.2L16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/>
                </svg>
              {%- when 'skin-type' -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"/>
                  <path d="M8 14s1.5 2 4 2 4-2 4-2"/>
                  <line x1="9" y1="9" x2="9.01" y2="9"/>
                  <line x1="15" y1="9" x2="15.01" y2="9"/>
                </svg>
              {%- else -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
            {%- endcase -%}
          </div>

          <h3 class="gm-benefit-card__title">{{ block.settings.title }}</h3>
          <p class="gm-benefit-card__desc">{{ block.settings.description }}</p>
        </div>
      {%- endfor -%}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "GlowMist Benefits",
  "tag": "div",
  "class": "glowmist-benefits-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Why GlowMist?"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Why You'll Love GlowMist"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Section Subheading",
      "default": "Crafted with clean ingredients for skin that feels refreshed, hydrated, and glowing — every single day."
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Benefit Title",
          "default": "Deep Hydration"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Benefit Description",
          "default": "Locks in moisture for hours with hyaluronic acid-powered hydration."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "hydration", "label": "Droplet (Hydration)" },
            { "value": "refresh", "label": "Refresh (Dull Skin)" },
            { "value": "formula", "label": "Flask (Formula)" },
            { "value": "travel", "label": "Plane (Travel-Friendly)" },
            { "value": "skin-type", "label": "Smile (All Skin Types)" },
            { "value": "check", "label": "Checkmark (Default)" }
          ],
          "default": "hydration"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GlowMist Benefits",
      "blocks": [
        { "type": "benefit", "settings": { "title": "Deep Hydration", "description": "Locks in moisture for hours with hyaluronic acid-powered hydration that keeps your skin plump and dewy.", "icon": "hydration" } },
        { "type": "benefit", "settings": { "title": "Refreshes Dull Skin", "description": "Instantly revives tired, dull-looking skin with a burst of rose water freshness.", "icon": "refresh" } },
        { "type": "benefit", "settings": { "title": "Non-Sticky Formula", "description": "Lightweight, fast-absorbing mist that leaves zero residue — just clean, natural glow.", "icon": "formula" } },
        { "type": "benefit", "settings": { "title": "Travel-Friendly", "description": "Compact 100ml bottle fits in any bag. Your hydration companion on every adventure.", "icon": "travel" } },
        { "type": "benefit", "settings": { "title": "All Skin Types", "description": "Gentle enough for sensitive skin, effective enough for oily or combination types.", "icon": "skin-type" } }
      ]
    }
  ]
}
{% endschema %}
