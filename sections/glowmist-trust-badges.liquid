{% comment %}
  GlowMist — Trust Badges Section
  ================================
  A horizontal strip of trust signals to boost
  buyer confidence immediately below the hero.

  Each badge is a block editable from the Customizer.
{% endcomment %}

<section class="gm-trust" aria-label="Trust badges">
  <div class="gm-container">
    <div class="gm-trust__grid">

      {%- for block in section.blocks -%}
        <div class="gm-trust__item gm-animate-in" {{ block.shopify_attributes }}>
          <div class="gm-trust__icon">
            {%- case block.settings.icon -%}
              {%- when 'vegan' -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M17 8C8 10 5.9 16.17 3.82 21.34l1.89.66.95-2.3c.48.17.98.3 1.34.3C19 20 22 3 22 3c-1 2-8 2.25-13 3.25S2 11.5 2 13.5s1.75 3.75 1.75 3.75"/>
                </svg>
              {%- when 'cruelty-free' -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                </svg>
              {%- when 'derma-tested' -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M9 12l2 2 4-4"/>
                  <path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/>
                </svg>
              {%- when 'free-returns' -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="1 4 1 10 7 10"/>
                  <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
                </svg>
              {%- else -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
            {%- endcase -%}
          </div>
          <span>{{ block.settings.text }}</span>
        </div>
      {%- endfor -%}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "GlowMist Trust Badges",
  "tag": "div",
  "class": "glowmist-trust-section",
  "max_blocks": 6,
  "settings": [],
  "blocks": [
    {
      "type": "badge",
      "name": "Trust Badge",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Badge Text",
          "default": "100% Vegan"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Badge Icon",
          "options": [
            { "value": "vegan", "label": "Leaf (Vegan)" },
            { "value": "cruelty-free", "label": "Heart (Cruelty-Free)" },
            { "value": "derma-tested", "label": "Checkmark (Tested)" },
            { "value": "free-returns", "label": "Arrow (Returns)" },
            { "value": "shield", "label": "Shield (Default)" }
          ],
          "default": "vegan"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GlowMist Trust Badges",
      "blocks": [
        { "type": "badge", "settings": { "text": "100% Vegan", "icon": "vegan" } },
        { "type": "badge", "settings": { "text": "Cruelty-Free", "icon": "cruelty-free" } },
        { "type": "badge", "settings": { "text": "Dermatologist Tested", "icon": "derma-tested" } },
        { "type": "badge", "settings": { "text": "Free Returns", "icon": "free-returns" } }
      ]
    }
  ]
}
{% endschema %}
