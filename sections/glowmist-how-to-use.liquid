{% comment %}
  GlowMist — How to Use Section
  ==============================
  A 3-step visual guide showing how to use the product.
  Steps are displayed as a horizontal timeline on desktop,
  vertical on mobile. Each step is a block.
{% endcomment %}

<section class="gm-section gm-how-to-use" id="gm-how-to-use" aria-label="How to use">
  <div class="gm-container">

    <p class="gm-eyebrow">{{ section.settings.eyebrow | default: 'Simple Routine' }}</p>
    <h2 class="gm-section__heading">{{ section.settings.heading | default: 'How to Use GlowMist' }}</h2>
    <p class="gm-section__subheading">{{ section.settings.subheading | default: 'Three easy steps to refreshed, glowing skin — anytime, anywhere.' }}</p>

    <div class="gm-steps">
      {%- assign step_number = 0 -%}
      {%- for block in section.blocks -%}
        {%- assign step_number = step_number | plus: 1 -%}
        <div class="gm-step gm-animate-in" {{ block.shopify_attributes }}>
          <div class="gm-step__number">{{ step_number }}</div>
          <div class="gm-step__text">
            <h3 class="gm-step__title">{{ block.settings.title }}</h3>
            <p class="gm-step__desc">{{ block.settings.description }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "GlowMist How to Use",
  "tag": "div",
  "class": "glowmist-how-to-use-section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Simple Routine"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "How to Use GlowMist"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Section Subheading",
      "default": "Three easy steps to refreshed, glowing skin — anytime, anywhere."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Usage Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Step Title",
          "default": "Spray"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Step Description",
          "default": "Hold the bottle 6–8 inches from your face and spray evenly on clean skin."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GlowMist How to Use",
      "blocks": [
        { "type": "step", "settings": { "title": "Spray on Clean Face", "description": "Hold the bottle 6–8 inches from your face and mist evenly. Close your eyes and enjoy the refreshing sensation." } },
        { "type": "step", "settings": { "title": "Let It Absorb", "description": "Give it 15–20 seconds to absorb naturally into your skin. No rubbing needed — the lightweight formula does the work." } },
        { "type": "step", "settings": { "title": "Use Anytime", "description": "Reapply throughout the day — after workouts, before makeup, or whenever your skin needs a hydration boost." } }
      ]
    }
  ]
}
{% endschema %}
