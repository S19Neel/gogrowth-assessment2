{% comment %}
  GlowMist — Clinical Proof & Dermatologist Trust Section
  =========================================================
  Builds customer confidence through clinical data, dermatologist
  endorsements, and transparent brand messaging. Positioned to
  contrast GlowMist's honesty with industry deception.

  All content is fully customizable from the Shopify Customizer.
{% endcomment %}

<section class="gm-section gm-clinical" id="gm-clinical" aria-label="Clinical proof and dermatologist endorsements">
  <div class="gm-container">

    {%- comment -%} ── Section Header ──────────────────────── {%- endcomment -%}
    <p class="gm-eyebrow">{{ section.settings.eyebrow | default: 'Clinically Proven' }}</p>
    <h2 class="gm-section__heading">{{ section.settings.heading | default: 'Dermatologist Approved. Lab Tested. Honest.' }}</h2>
    <p class="gm-clinical__subheading">
      {{ section.settings.subheading | default: 'In an industry full of exaggerated claims and hidden ingredients, we chose a different path. Every batch of GlowMist is lab-tested and dermatologist-reviewed — because your skin deserves proof, not promises. We are as clear with our customers as our mist.' }}
    </p>

    {%- comment -%} ── Clinical Stats Bar ──────────────────── {%- endcomment -%}
    {%- assign stat_blocks = section.blocks | where: "type", "stat" -%}
    {%- if stat_blocks.size > 0 -%}
      <div class="gm-clinical__stats">
        {%- for block in stat_blocks -%}
          <div class="gm-clinical__stat gm-animate-in" {{ block.shopify_attributes }}>
            <span class="gm-clinical__stat-number">{{ block.settings.number }}</span>
            <span class="gm-clinical__stat-label">{{ block.settings.label }}</span>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} ── Certification Badges ────────────────── {%- endcomment -%}
    {%- assign badge_blocks = section.blocks | where: "type", "certification" -%}
    {%- if badge_blocks.size > 0 -%}
      <div class="gm-clinical__badges">
        {%- for block in badge_blocks -%}
          <div class="gm-clinical__badge gm-animate-in" {{ block.shopify_attributes }}>
            <div class="gm-clinical__badge-icon">
              {%- case block.settings.icon -%}
                {%- when 'lab' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                       stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M9 3h6v7l5 8H4l5-8V3z"/>
                    <line x1="9" y1="3" x2="15" y2="3"/>
                  </svg>
                {%- when 'shield' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                       stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    <path d="M9 12l2 2 4-4"/>
                  </svg>
                {%- when 'microscope' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                       stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M6 18h8"/>
                    <path d="M3 22h18"/>
                    <path d="M14 22a7 7 0 1 0 0-14h-1"/>
                    <path d="M9 14h2"/>
                    <path d="M9 12a2 2 0 0 1-2-2V6h6v4a2 2 0 0 1-2 2Z"/>
                    <path d="M12 6V3a1 1 0 0 0-1-1H9a1 1 0 0 0-1 1v3"/>
                  </svg>
                {%- when 'certificate' -%}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                       stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="2"/>
                    <path d="M7 8h10"/>
                    <path d="M7 12h6"/>
                    <path d="M17 17l-2-2-2 2"/>
                    <circle cx="15" cy="13" r="2"/>
                  </svg>
                {%- else -%}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                       stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                    <polyline points="22 4 12 14.01 9 11.01"/>
                  </svg>
              {%- endcase -%}
            </div>
            <span class="gm-clinical__badge-text">{{ block.settings.text }}</span>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} ── Dermatologist Testimonial Cards ─────── {%- endcomment -%}
    {%- assign testimonial_blocks = section.blocks | where: "type", "testimonial" -%}
    {%- if testimonial_blocks.size > 0 -%}
      <div class="gm-clinical__testimonials">
        {%- for block in testimonial_blocks -%}
          <div class="gm-clinical__testimonial gm-animate-in" {{ block.shopify_attributes }}>
            <div class="gm-clinical__testimonial-header">
              {%- if block.settings.avatar != blank -%}
                <!-- Add image: dermatologist headshot -->
                <img
                  class="gm-clinical__testimonial-avatar"
                  src="{{ block.settings.avatar | image_url: width: 80 }}"
                  alt="{{ block.settings.name | escape }}"
                  width="60"
                  height="60"
                  loading="lazy"
                  decoding="async"
                >
              {%- else -%}
                <div class="gm-clinical__testimonial-avatar-placeholder">
                  {{ block.settings.name | slice: 0, 1 | upcase }}
                </div>
              {%- endif -%}
              <div>
                <span class="gm-clinical__testimonial-name">{{ block.settings.name }}</span>
                <span class="gm-clinical__testimonial-title">{{ block.settings.credentials }}</span>
              </div>
            </div>
            <blockquote class="gm-clinical__testimonial-quote">
              "{{ block.settings.quote }}"
            </blockquote>
            {%- if block.settings.rating > 0 -%}
              {% render 'glowmist-star-rating', rating: block.settings.rating, max: 5 %}
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} ── Transparency Callout ────────────────── {%- endcomment -%}
    {%- if section.settings.callout_text != blank -%}
      <div class="gm-clinical__callout">
        <div class="gm-clinical__callout-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
        </div>
        <p>{{ section.settings.callout_text }}</p>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "GlowMist Clinical Proof",
  "tag": "div",
  "class": "glowmist-clinical-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Clinically Proven"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Dermatologist Approved. Lab Tested. Honest."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "In an industry full of exaggerated claims and hidden ingredients, we chose a different path. Every batch of GlowMist is lab-tested and dermatologist-reviewed — because your skin deserves proof, not promises. We are as clear with our customers as our mist."
    },
    {
      "type": "textarea",
      "id": "callout_text",
      "label": "Transparency Callout",
      "default": "Every single ingredient in GlowMist is listed, sourced ethically, and backed by clinical research. No greenwashing. No fine print. No hidden nasties. Just clean, honest skincare that works.",
      "info": "A highlighted block at the bottom reinforcing brand honesty. Leave blank to hide."
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Clinical Stat",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Stat Number",
          "default": "97%"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Stat Label",
          "default": "saw improved hydration in 4 weeks"
        }
      ]
    },
    {
      "type": "certification",
      "name": "Certification Badge",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Badge Text",
          "default": "Lab Tested"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Badge Icon",
          "options": [
            { "value": "lab", "label": "Flask (Lab)" },
            { "value": "shield", "label": "Shield (Verified)" },
            { "value": "microscope", "label": "Microscope (Research)" },
            { "value": "certificate", "label": "Certificate (Certified)" },
            { "value": "check", "label": "Checkmark (Default)" }
          ],
          "default": "lab"
        }
      ]
    },
    {
      "type": "testimonial",
      "name": "Dermatologist Testimonial",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Dermatologist Name",
          "default": "Dr. Anjali Mehta"
        },
        {
          "type": "text",
          "id": "credentials",
          "label": "Credentials / Title",
          "default": "MD Dermatology, 12+ years experience"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Photo",
          "info": "Optional headshot. 80×80px recommended."
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Testimonial Quote",
          "default": "GlowMist uses a clinically effective concentration of Hyaluronic Acid combined with soothing Aloe Vera. The formulation is gentle enough for daily use on all skin types, including sensitive skin. I recommend it to my patients."
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5,
          "info": "Set to 0 to hide stars."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GlowMist Clinical Proof",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "number": "97%",
            "label": "reported visibly improved hydration within 4 weeks"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "4.8/5",
            "label": "average dermatologist approval rating"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "0",
            "label": "parabens, sulfates, or harmful chemicals"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "100%",
            "label": "ingredients sourced and fully disclosed"
          }
        },
        {
          "type": "certification",
          "settings": {
            "text": "Lab Tested Every Batch",
            "icon": "lab"
          }
        },
        {
          "type": "certification",
          "settings": {
            "text": "Dermatologist Verified",
            "icon": "shield"
          }
        },
        {
          "type": "certification",
          "settings": {
            "text": "Clinical Research Backed",
            "icon": "microscope"
          }
        },
        {
          "type": "certification",
          "settings": {
            "text": "GMP Certified Facility",
            "icon": "certificate"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "name": "Dr. Anjali Mehta",
            "credentials": "MD Dermatology, 12+ years experience",
            "quote": "GlowMist uses a clinically effective concentration of Hyaluronic Acid combined with soothing Aloe Vera. The formulation is gentle enough for daily use on all skin types, including sensitive skin. I recommend it to my patients.",
            "rating": 5
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "name": "Dr. Priya Sharma",
            "credentials": "Cosmetic Dermatologist, MBBS, DVD",
            "quote": "What sets GlowMist apart is its transparency. Every ingredient is disclosed at clinical-grade detail — something very few Indian skincare brands do. The Rose Water and Green Tea Extract combination is excellent for antioxidant protection.",
            "rating": 5
          }
        }
      ]
    }
  ]
}
{% endschema %}
